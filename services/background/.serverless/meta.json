{
  "/home/dev/Desktop/learninough-server/services/background/serverless.yml": {
    "versionFramework": "4.37.0",
    "servicePath": "/home/dev/Desktop/learninough-server/services/background/serverless.yml",
    "serviceConfigFileName": "serverless.yml",
    "service": {
      "service": "background-service",
      "provider": {
        "name": "aws",
        "runtime": "nodejs20.x",
        "region": "ap-south-1",
        "timeout": 30,
        "environment": {
          "VIDEO_UPLOAD_QUEUE_URL": {
            "Ref": "VideoUploadQueue"
          },
          "COURSE_INTRO_VIDEO_QUEUE_URL": {
            "Ref": "CourseIntroVideoUploadQueue"
          }
        },
        "iam": {
          "role": {
            "statements": [
              {
                "Effect": "Allow",
                "Action": [
                  "sqs:ReceiveMessage",
                  "sqs:DeleteMessage",
                  "sqs:GetQueueAttributes"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "VideoUploadQueue",
                    "Arn"
                  ]
                }
              },
              {
                "Effect": "Allow",
                "Action": [
                  "sqs:ReceiveMessage",
                  "sqs:DeleteMessage",
                  "sqs:GetQueueAttributes"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "CourseIntroVideoUploadQueue",
                    "Arn"
                  ]
                }
              },
              {
                "Effect": "Allow",
                "Action": [
                  "sqs:ReceiveMessage",
                  "sqs:DeleteMessage",
                  "sqs:GetQueueAttributes"
                ],
                "Resource": {
                  "Fn::GetAtt": [
                    "ChatNotificationQueue",
                    "Arn"
                  ]
                }
              }
            ]
          }
        },
        "stage": "dev",
        "versionFunctions": true
      },
      "plugins": [
        "serverless-offline"
      ],
      "custom": {
        "serverless-offline": {
          "httpPort": 3002,
          "lambdaPort": 3003
        }
      },
      "resources": {
        "Resources": {
          "VideoUploadQueue": {
            "Type": "AWS::SQS::Queue",
            "Properties": {
              "QueueName": "video-upload-queue",
              "VisibilityTimeout": 300
            }
          },
          "CourseIntroVideoUploadQueue": {
            "Type": "AWS::SQS::Queue",
            "Properties": {
              "QueueName": "course-intro-video-upload-queue",
              "VisibilityTimeout": 300
            }
          },
          "ChatNotificationQueue": {
            "Type": "AWS::SQS::Queue",
            "Properties": {
              "QueueName": "chat-notification-queue",
              "VisibilityTimeout": 300
            }
          }
        }
      },
      "functions": {
        "createVideoUploadProgress": {
          "handler": "src/functions/video/processVideoUpload.handler",
          "events": [
            {
              "http": {
                "path": "/video/create-upload-progress",
                "method": "post"
              }
            }
          ],
          "name": "background-service-dev-createVideoUploadProgress"
        },
        "saveBankDetails": {
          "handler": "src/functions/bank/saveBankDetails.handler",
          "events": [
            {
              "http": {
                "path": "faculty/bank/details",
                "method": "post",
                "cors": true
              }
            }
          ],
          "name": "background-service-dev-saveBankDetails"
        },
        "getBankDetails": {
          "handler": "src/functions/bank/getBankDetails.handler",
          "events": [
            {
              "http": {
                "path": "faculty/bank/details",
                "method": "get",
                "cors": true
              }
            }
          ],
          "name": "background-service-dev-getBankDetails"
        },
        "processVideoUpload": {
          "handler": "src/functions/video/processVideoUpload.handler",
          "events": [
            {
              "sqs": {
                "arn": {
                  "Fn::GetAtt": [
                    "VideoUploadQueue",
                    "Arn"
                  ]
                },
                "batchSize": 1
              }
            }
          ],
          "name": "background-service-dev-processVideoUpload"
        },
        "courseIntroVideoUpload": {
          "handler": "src/functions/video/courseIntroVideoUpload.handler",
          "events": [
            {
              "sqs": {
                "arn": {
                  "Fn::GetAtt": [
                    "CourseIntroVideoUploadQueue",
                    "Arn"
                  ]
                },
                "batchSize": 1
              }
            }
          ],
          "name": "background-service-dev-courseIntroVideoUpload",
          "environment": {
            "NODE_OPTIONS": "--enable-source-maps"
          }
        },
        "chatNotificationWorker": {
          "handler": "src/functions/chat/chat.notification.handler",
          "events": [
            {
              "sqs": {
                "arn": {
                  "Fn::GetAtt": [
                    "ChatNotificationQueue",
                    "Arn"
                  ]
                },
                "batchSize": 1
              }
            }
          ],
          "name": "background-service-dev-chatNotificationWorker"
        },
        "syncVideoProgress": {
          "handler": "src/functions/video/syncVideoProgress.handler",
          "events": [
            {
              "schedule": {
                "rate": [
                  "rate(5 minutes)"
                ],
                "enabled": false
              }
            }
          ],
          "name": "background-service-dev-syncVideoProgress",
          "environment": {
            "NODE_OPTIONS": "--enable-source-maps"
          }
        },
        "tpstreamsWebhook": {
          "handler": "src/functions/webhooks/tpstreamsWebhook.handler",
          "events": [
            {
              "http": {
                "path": "/webhooks/tpstreams",
                "method": "post"
              }
            }
          ],
          "name": "background-service-dev-tpstreamsWebhook"
        }
      }
    },
